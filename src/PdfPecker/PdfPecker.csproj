<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- The .NET preview workflow adds the next .NET as an extra target; the released package never has it. -->
    <TargetFrameworks Condition="'$(PreviewTargetFramework)' != ''">$(TargetFrameworks);$(PreviewTargetFramework)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PdfPecker</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>PdfPecker</PackageId>
    <!-- Local builds pack as a pre-release above the API baseline; CI passes the real version. -->
    <Version>1.13.1-dev</Version>
    <Authors>Moonwalker1307</Authors>
    <Description>Fast, dependency-free HTML and Markdown to PDF converter for C# and .NET. Its own HTML parser, Markdown parser (CommonMark + GFM), CSS engine, layout engine and PDF writer: no browser, no native binaries, no third-party packages.</Description>
    <PackageTags>html;pdf;html-to-pdf;htmltopdf;pdf-generator;pdf-generation;csharp;dotnet;aspnetcore;invoice;markdown;markdown-to-pdf;markdown-to-html;commonmark;converter;css;report;pdfa;zugferd;factur-x;e-invoice;pdf-forms;acroform;pdf-to-html</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://pdfpecker.net/</PackageProjectUrl>
    <!-- nuget.org only accepts OSI/FSF-approved licenses in an expression (not Bitstream-Vera or APAFML), so the package
         points at the notices file, which reproduces every license that applies. -->
    <PackageLicenseFile>THIRD-PARTY-NOTICES.md</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 Moonwalker1307</Copyright>
    <RepositoryUrl>https://github.com/Moonwalker1307/PdfPecker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Pack compares the public API with the last release on nuget.org and fails on a breaking change, so one cannot
         ship in a minor release by accident. Raise the baseline after each release; a deliberate break needs a major
         version and a CompatibilitySuppressions.xml entry. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.13.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- CI builds use repository-relative source paths in the PDB, so builds are reproducible from the same commit. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <!-- The notices refer to LICENSE for the library's own MIT license. -->
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../assets/logo.png" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Rendering/Fonts/StandardFonts.bin" LogicalName="PdfPecker.Rendering.Fonts.StandardFonts.bin" />
    <EmbeddedResource Include="Fonts/Bundled/*.ttf.br" LogicalName="PdfPecker.Fonts.Bundled.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Text/Hyphenation/*.hyph.br;Text/Hyphenation/*.tex.br" LogicalName="PdfPecker.Text.Hyphenation.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="PdfPecker.Tests" />
    <InternalsVisibleTo Include="FontPackBuilder" />
    <InternalsVisibleTo Include="PdfPecker.Fuzz" />
    <InternalsVisibleTo Include="PdfPecker.Benchmarks" />
  </ItemGroup>

</Project>
