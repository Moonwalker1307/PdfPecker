<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PdfPecker</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>PdfPecker</PackageId>
    <Version>0.1.0</Version>
    <Authors>Moonwalker1307</Authors>
    <Description>Fast, dependency-free HTML and Markdown to PDF converter for .NET. Its own HTML parser, Markdown parser (CommonMark + GFM), CSS engine, layout engine and PDF writer: no browser, no native binaries, no third-party packages.</Description>
    <PackageTags>html;pdf;html-to-pdf;markdown;markdown-to-pdf;markdown-to-html;commonmark;converter;css;report;pdfa;zugferd;factur-x;e-invoice;pdf-forms;acroform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT AND OFL-1.1 AND Bitstream-Vera AND APAFML AND BSD-3-Clause</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Moonwalker1307</Copyright>
    <RepositoryUrl>https://github.com/Moonwalker1307/PdfPecker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Rendering/Fonts/StandardFonts.bin" LogicalName="PdfPecker.Rendering.Fonts.StandardFonts.bin" />
    <EmbeddedResource Include="Fonts/Bundled/*.ttf.br" LogicalName="PdfPecker.Fonts.Bundled.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="PdfPecker.Tests" />
    <InternalsVisibleTo Include="FontPackBuilder" />
  </ItemGroup>

</Project>
