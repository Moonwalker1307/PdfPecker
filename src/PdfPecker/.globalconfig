is_global = true

# Output must not depend on the culture of the machine a conversion runs on. These rules catch formatting and string
# comparisons that use the current culture; int.TryParse(string, out int) is not covered, so use Invariant.TryParseInt.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1310.severity = warning

# Performance rules. The library is sealed, static and span-based by design; these keep it that way, so a new class
# that could be sealed, a method that could be static, or a substring that could be a span breaks the build. CA1849 is
# left off because the signing code shares one method between the synchronous and asynchronous paths on purpose.
dotnet_diagnostic.CA1802.severity = warning
dotnet_diagnostic.CA1805.severity = warning
dotnet_diagnostic.CA1810.severity = warning
dotnet_diagnostic.CA1812.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1823.severity = warning
