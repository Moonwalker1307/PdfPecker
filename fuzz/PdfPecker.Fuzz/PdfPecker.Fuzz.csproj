<Project Sdk="Microsoft.NET.Sdk">

  <!-- A dependency-free mutation fuzzer for the library's parsers of untrusted input. It has no package references, so it
       is part of PdfPecker.sln; see README.md in the fuzz folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>PdfPecker.Fuzz</RootNamespace>
    <!-- Non-concurrent workstation GC keeps the heap size honest for the memory watch. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <!-- A hard heap limit turns a runaway allocation into an OutOfMemoryException the fuzzer can classify, instead of the
         kernel killing the process. It sits above the 1.5 GB ceiling the watchdog enforces. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="2684354560" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdfPecker/PdfPecker.csproj" />
  </ItemGroup>

</Project>
