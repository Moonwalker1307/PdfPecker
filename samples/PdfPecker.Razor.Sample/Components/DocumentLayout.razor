<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>@Title</title>
    <style>
        @@page { size: A4; margin: 20mm 18mm; }
        body { font-family: sans-serif; font-size: 10pt; color: #1f2933; }
        h1 { font-size: 20pt; margin: 0 0 4mm; color: #0b5cad; }
        table { width: 100%; border-collapse: collapse; margin-top: 8mm; }
        th { text-align: left; border-bottom: 1.5pt solid #0b5cad; padding: 2mm 0; }
        td { border-bottom: 0.5pt solid #cbd2d9; padding: 2mm 0; }
        .number { text-align: right; }
        .total td { border-bottom: none; font-weight: bold; padding-top: 4mm; }
        footer { position: fixed; bottom: 0; font-size: 8pt; color: #616e7c; }
    </style>
</head>
<body>
    @ChildContent
    <footer>Thank you for your business.</footer>
</body>
</html>

@code {
    // A layout as a component with child content, rather than @layout or LayoutView: those set the layout's type by
    // reflection, which trimming and Native AOT warn about, and they cannot take parameters such as the title.
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
