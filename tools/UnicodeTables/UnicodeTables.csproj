<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regenerates src/PdfPecker/Text/UnicodeTables.g.cs from the Unicode Character Database.
       Run manually from the repository root: dotnet run (project tools/UnicodeTables), see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
