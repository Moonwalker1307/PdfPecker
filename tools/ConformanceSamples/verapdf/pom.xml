<?xml version="1.0" encoding="UTF-8"?>
<!-- Pins the veraPDF command-line validator that the conformance workflow runs. Nothing here ships in the NuGet
     package; `mvn dependency:copy-dependencies` downloads the jars from Maven Central. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.pdfpecker.tools</groupId>
  <artifactId>verapdf-runner</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <dependencies>
    <dependency>
      <groupId>org.verapdf.apps</groupId>
      <artifactId>greenfield-apps</artifactId>
      <version>1.28.2</version>
    </dependency>
  </dependencies>
</project>
