<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regenerates src/PdfPecker/Rendering/Fonts/StandardFonts.bin from installed Liberation and DejaVu fonts.
       Run manually from the repository root: dotnet run (project tools/FontPackBuilder), see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdfPecker/PdfPecker.csproj" />
  </ItemGroup>

</Project>
