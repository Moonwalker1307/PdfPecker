<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compares two versions of PdfPecker; bench/compare-versions.sh runs it. Usage is at the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdfPecker/PdfPecker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/PdfPecker.Sample/html/**" LinkBase="html" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../PdfPecker.Benchmarks/Documents.cs" Link="Documents.cs" />
  </ItemGroup>

</Project>
