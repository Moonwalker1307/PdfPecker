<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdfPecker.Fluent/PdfPecker.Fluent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../samples/PdfPecker.Fluent.Sample/Examples.cs" Link="Examples.cs" />
    <None Include="../../samples/PdfPecker.Fluent.Sample/assets/**" Link="assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
