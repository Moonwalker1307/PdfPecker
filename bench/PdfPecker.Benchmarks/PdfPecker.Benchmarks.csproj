<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdfPecker/PdfPecker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/PdfPecker.Sample/html/**" LinkBase="html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/PdfPecker.Tests/Fixtures/images/*.bmp;../../tests/PdfPecker.Tests/Fixtures/images/*.webp;../../tests/PdfPecker.Tests/Fixtures/images/*.tif;../../tests/PdfPecker.Tests/Fixtures/features.pdf" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
