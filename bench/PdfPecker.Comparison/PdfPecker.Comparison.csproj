<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compares PdfPecker with other .NET HTML-to-PDF converters. Deliberately not in PdfPecker.sln, so its
       third-party packages never reach the library, its tests or CI. Usage is at the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="itext.pdfhtml" Version="6.3.4" />
    <PackageReference Include="Syncfusion.HtmlToPdfConverter.Net.Linux" Version="35.1.40" />
    <ProjectReference Include="../../src/PdfPecker/PdfPecker.csproj" />
    <PackageReference Include="PuppeteerSharp" Version="25.13.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="HtmlRenderer.PdfSharp" Version="1.6.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/PdfPecker.Sample/html/**" LinkBase="html" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../PdfPecker.Benchmarks/Documents.cs" Link="Documents.cs" />
  </ItemGroup>

</Project>
