<ul>
    @foreach (var item in items)
    {
        <li>@item</li>
    }
</ul>

@code {
    private string[] items = [];

    // Data loaded asynchronously, as from a database, must be in the HTML: the renderer waits for it.
    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(20);
        items = ["Apples", "Pears"];
    }
}
